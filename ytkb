    vid = video_id(a.id) or a.id
    v = con.execute("select * from videos where id=?", (vid,)).fetchone()
    if not v:
        sys.exit(f"not in knowledge base: {a.id}")
    print(f"# {v['title']} — {v['channel']}\nuploaded {v['upload_date']} · "
          f"{ts(v['duration'] or 0)} · https://youtu.be/{vid} · {v['transcript_source']}\n")
    if a.summary:
        print(v["summary"] or "(no summary yet; run `ytkb summarize`)")
        return
    segs = sorted(con.execute("select start, text from segments_fts where video_id=?", (vid,)),
                  key=lambda s: float(s["start"]))
    if a.at is not None:
        segs = [s for s in segs if a.at - a.window / 2 <= float(s["start"]) <= a.at + a.window / 2]
    for s in segs:
        print(f"[{ts(float(s['start']))} t={int(float(s['start']))}] {s['text']}")


